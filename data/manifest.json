  "definitions": {
    "is_clean": "NOT (flag_extreme_paid OR flag_bad_billing_npi OR flag_bad_servicing_npi OR flag_no_npi OR flag_nonstandard_hcpcs OR flag_negative_paid)",
    "hcbs_strict": "HCPCS_CODE IN ('T1019','T1020','S5125','S5126','S5130','S5131',\n  'S5100','S5101','S5102','S5105','S5140','S5150','S5151',\n  'T1000','T1001','T1002','T1003','T1004','T1005','S9122','S9123','S9124','G0156')\n  OR HCPCS_CODE BETWEEN 'T2016' AND 'T2036'",
    "hcbs_broad": "HCPCS_CODE IN ('T1019','T1020','S5125','S5126','S5130','S5131',\n  'S5100','S5101','S5102','S5105','S5140','S5150','S5151',\n  'T1000','T1001','T1002','T1003','T1004','T1005','S9122','S9123','S9124','G0156')\n  OR HCPCS_CODE BETWEEN 'T2016' AND 'T2036' OR HCPCS_CODE IN ('H2014','H2015','H2016','H0043','H0044','S5135','S5136','S5160','S5161','S5165','S5170','T2038','H2021','H2022')",
    "domain": "(HCPCS_CODE IN ('T1019','T1020','S5125','S5126','S5130','S5131',\n  'S5100','S5101','S5102','S5105','S5140','S5150','S5151',\n  'T1000','T1001','T1002','T1003','T1004','T1005','S9122','S9123','S9124','G0156')\n  OR HCPCS_CODE BETWEEN 'T2016' AND 'T2036' OR HCPCS_CODE IN ('H2014','H2015','H2016','H0043','H0044','S5135','S5136','S5160','S5161','S5165','S5170','T2038','H2021','H2022')) OR HCPCS_CODE = 'Z9525'",
    "category": "CASE\n  WHEN HCPCS_CODE = 'Z9525' THEN 'california_code'\n  WHEN HCPCS_CODE IN ('T1019','T1020','S5125','S5126','S5130','S5131') THEN 'personal_care'\n  WHEN HCPCS_CODE BETWEEN 'T2016' AND 'T2036' OR HCPCS_CODE IN ('S5100','S5101','S5102','S5105','S5140','S5150','S5151') THEN 'residential_day'\n  WHEN HCPCS_CODE BETWEEN 'T1000' AND 'T1005' OR HCPCS_CODE IN ('S9122','S9123','S9124','G0156') THEN 'home_nursing'\n  WHEN HCPCS_CODE IN ('H2014','H2015','H2016','H2021','H2022') THEN 'community_support'\n  WHEN HCPCS_CODE IN ('H0043','H0044','H2023','H2025','S5135','S5136','S5160','S5161','S5165','S5170','T2038') THEN 'housing_meals'\n  WHEN regexp_matches(HCPCS_CODE, '^\\d{5}$') THEN 'medical_visits'\n  ELSE 'other'\nEND",
